# Servidor-a-servidor: la misma key de OpenAI que usa gloriapp. NUNCA se
# expone al navegador (a diferencia del flujo de token efimero que se probo
# y se descarto en la Etapa 2 por no poder cerrar la sesion de verdad).
OPENAI_API_KEY=sk-...

# Compartido con gloriapp (misma variable, mismo valor, en ambos .env). Firma
# los tickets de sesion y autentica el endpoint interno /internal/sessions/:id/close.
VOICE_RELAY_SHARED_SECRET=

# "real" conecta a la Realtime API de OpenAI de verdad (gasta). "simulated"
# genera un tono/echo local — para probar ticket/deadline/cierre sin costo.
VOICE_PROVIDER=simulated

PORT=8788
