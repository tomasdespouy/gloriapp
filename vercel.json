{
  "functions": {
    "src/app/api/chat/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/sessions/*/evaluate/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/research/poll/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/research/scan/poll/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/dispatch-credentials/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/informe-semanal/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-sessions",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/dispatch-credentials",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/remind-unclosed-sessions",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/informe-semanal",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/informe-semanal",
      "schedule": "0 11 * * 1"
    }
  ]
}
